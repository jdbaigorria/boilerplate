# Application Settings
APP_NAME=FastAPI SaaS Boilerplate
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
USE_POSTGRES=true
USE_MONGODB=false

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=saas_db

# MongoDB (if USE_MONGODB=true)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=saas_db

# Authentication
ENABLE_JWT_AUTH=true
ENABLE_OAUTH_GOOGLE=false
ENABLE_OAUTH_GITHUB=false

# OAuth - Google (if ENABLE_OAUTH_GOOGLE=true)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# OAuth - GitHub (if ENABLE_OAUTH_GITHUB=true)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# SaaS Features
ENABLE_MULTI_TENANCY=true
ENABLE_SUBSCRIPTIONS=true
ENABLE_INVITATIONS=true
ENABLE_BACKGROUND_TASKS=false
ENABLE_WEBHOOKS=false

# Rate Limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# Email (if ENABLE_EMAIL=true)
ENABLE_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=FastAPI SaaS

# AI Services (if ENABLE_AI_SERVICE=true)
ENABLE_AI_SERVICE=false
AI_PROVIDER=  # openai, anthropic, gemini

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=4096

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Monitoring
ENABLE_MONITORING=true
ENABLE_PROMETHEUS=false
ENABLE_SENTRY=false
SENTRY_DSN=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or pretty
LOG_FILE=

# Stripe (if ENABLE_SUBSCRIPTIONS=true)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Celery (if ENABLE_BACKGROUND_TASKS=true)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# File Storage
ENABLE_FILE_STORAGE=false
STORAGE_TYPE=local  # local, s3, gcs
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# AWS S3 (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
